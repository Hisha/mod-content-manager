[worldserver]

ContentManager.Enable = 1

# Directory where portable .epf packages are dropped.
ContentManager.PatchHoldDirectory = "/home/smithkt/azerothcore-wotlk/patchhold"

# Working directory used while unpacking/building content.
ContentManager.WorkDirectory = "/home/smithkt/azerothcore-wotlk/patchwork"

# Final generated realm patches.
ContentManager.OutputDirectory = "/home/smithkt/azerothcore-wotlk/patches"

#
#    ContentManager.ModuleDirectory
#        Directory containing installed AzerothCore modules.
#        Content Manager searches <module>/content/*.epf for
#        module-provided content packages.
#
#        Default: "../modules"
#

ContentManager.ModuleDirectory = "/home/smithkt/azerothcore-wotlk/modules"

# Optional read-only directory holding an administrator-selected build-12340
# DBC baseline. Empty by default; raw Schema 1 EPFs do not use it.
ContentManager.BaselineDbcDirectory = "/home/smithkt/azerothcore-wotlk/env/data/dbc"

# DBC inspection currently supports only WoW 3.3.5a build 12340.
# Raw Schema 1 EPF operations are independent of this setting.
ContentManager.ClientBuild = 12340

# Optional stricter Item pin. Existing configured pins are validated during registry
# migration and every build. Empty uses the persistent generic baseline registry.
ContentManager.ItemBaselineSha256 = ""


# Filesystem destination for versioned MPQs published by explicit activation.
# Relative paths resolve from the worldserver working directory.
# Must not overlap OutputDirectory. Created on activation if needed.
ContentManager.PublishDirectory = "/mnt/ai_data/linkable"

# Optional stricter CurrencyTypes pin, retained for backward compatibility.
# Empty uses automatic first-use registration and exact subsequent matching.
ContentManager.CurrencyTypesBaselineSha256 = ""

# BaselineDbcDirectory and ClientBuild select administrator-provided baseline files.
# Validated baselines register automatically on first build; later bytes must match
# the persistent baseline registry. Existing SHA settings above are optional stricter
# overrides. No per-DBC SHA setting is needed for CurrencyCategory or future tables.
# Inspect: .content dbc inspect <table> (read-only, no pin required)
# Replace intentionally: .content dbc review <table>, then .content dbc approve <table> <review-number>
# Approval revalidates the candidate and compare-and-swaps the accepted revision.
